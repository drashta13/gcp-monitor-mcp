{
  "name": "gcp-monitor-mcp",
  "version": "0.7.0",
  "description": "MCP server for monitoring Google Cloud usage, cost and health",
  "type": "module",
  "bin": {
    "gcp-monitor-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "capture": "node src/capture-cli.js",
    "report-pdf": "node scripts/report-pdf.mjs",
    "test": "node --test",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js",
    "coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@google-cloud/appoptimize": "^0.4.0",
    "@google-cloud/asset": "^7.1.1",
    "@google-cloud/bigquery": "^9.2.0",
    "@google-cloud/monitoring": "^6.1.1",
    "@google-cloud/resource-manager": "^7.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "google-auth-library": "^11.3.0",
    "zod": "^4.6.5"
  }
}
